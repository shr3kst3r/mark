#compdef mark mark-cli
# zsh completion for mark(1). Installed as `_mark` on $fpath.
#
# Hand-written rather than generated by clap_complete, for the reason the man
# page gives: the file is small, adding a code-generating dependency to a binary
# that already ships twice in a 34 MB bundle is a poor trade, and
# `the_man_page_and_completions_name_every_subcommand` in cli/src/main.rs fails
# if a subcommand or a long flag is added without being listed here. Drift is
# caught by a test rather than avoided by a generator.
#
# Two things worth knowing if you edit this:
#   * `mark theme` completes theme *names* from `mark theme --list --json`,
#     which is answered locally by the core and needs no running app.
#   * `mark tab select|close` completes live tab indices from `mark tab list`,
#     which does need one — so it stays silent rather than launching the app.

_mark_themes() {
  local -a names
  names=(${(f)"$(_call_program mark-themes "${words[1]}" theme --list 2>/dev/null | awk 'NR>1 {print $1}')"})
  (( ${#names} )) && _describe -t themes 'theme' names
}

# The five task states, from `2026-08-27-five-task-states`. Hard-coded rather
# than asked for: the CLI has no verb that lists them, and an unknown name is a
# usage error, so offering the wrong set would be offering a failure.
_mark_states() {
  local -a states
  states=(
    'open:not started'
    'in-progress:started, not finished'
    'done:finished'
    'cancelled:dropped, and out of the count'
    'blocked:waiting on something else'
  )
  _describe -t states 'state' states
}

# `--due-before`/`--due-after` take a date, `today`, or a `+Nd` offset. Only the
# two words are completable; a date is typed.
_mark_when() {
  local -a when
  when=('today:the local date, or --today' '+7d:seven days from today')
  _describe -t when 'when' when
}

_mark_tabs() {
  # Only if the app is already listening: completion must never start a GUI.
  local -a tabs
  tabs=(${(f)"$(MARK_NO_LAUNCH=1 _call_program mark-tabs "${words[1]}" tab list 2>/dev/null | awk '{print $2}')"})
  (( ${#tabs} )) && _describe -t tabs 'tab' tabs
}

_mark() {
  local context state state_descr line
  typeset -A opt_args

  local -a commands
  commands=(
    'render:render a document to stdout'
    'diff:show what changed against git HEAD'
    'toc:print the heading tree'
    'tasks:list every task in a file or directory'
    'check:set, clear, or flip one checkbox in place'
    'normalize:rewrite the extended task markers as plain GFM'
    'ls:list markdown files with titles and task counts'
    'grep:search, reporting the heading each match sits under'
    'links:every link and image, and whether its target is there'
    'watch:block until a file or directory changes'
    'stats:per-stage timings and counters for one document'
    'doctor:environment report for a bug report'
    'open:open a file in a tab, or root the sidebar at a directory'
    'tab:list, select, and close the app'\''s tabs'
    'theme:choose a theme, or inspect the ones there are'
    'goto:scroll the front document to a heading anchor'
    'reload:re-read the front document from disk'
    'sidebar:report the sidebar root, breadcrumb, and history'
    'nav:move the sidebar'\''s root'
  )

  _arguments -C \
    '(- *)'{-h,--help}'[print help]' \
    '(- *)'{-V,--version}'[print version]' \
    '1: :{_describe -t commands "mark command" commands}' \
    '*:: :->args' && return 0

  case "$state" in
    args)
      case "${words[1]}" in
        render)
          _arguments \
            '(--ansi --plain)--html[a complete, self-contained HTML document]' \
            '(--html --plain)--ansi[styled terminal output]' \
            '(--html --ansi)--plain[terminal output with no escape sequences]' \
            '--prefix=[emit only the first N top-level blocks]:blocks:' \
            '--theme=[theme to render with]:theme:_mark_themes' \
            '1:file:_files -g "*.md"'
          ;;
        diff)
          _arguments \
            '(--ansi --plain)--html[the rendered diff, as a self-contained document]' \
            '(--html --plain)--ansi[styled terminal output]' \
            '(--html --ansi)--plain[terminal output with no escape sequences]' \
            '--json[machine-readable output]' \
            '--stat[counts only, no hunks]' \
            '--tracked[leave untracked files out]' \
            '--theme=[theme for --html and --ansi]:theme:_mark_themes' \
            '1:path:_files'
          ;;
        toc|stats)
          _arguments '--json[machine-readable output]' '1:file:_files -g "*.md"'
          ;;
        tasks)
          _arguments \
            '--open[only tasks still outstanding: open, in progress, or blocked]' \
            '*--state=[only this state (repeatable)]:state:_mark_states' \
            '*--tag=[only tasks carrying this @tag (repeatable)]:tag:' \
            '--priority=[only this priority or higher: 1, 2, or 3]:priority:(1 2 3)' \
            '--due-before=[only tasks due strictly before a date]:when:_mark_when' \
            '--due-after=[only tasks due strictly after a date]:when:_mark_when' \
            '--overdue[only tasks due before today]' \
            '--no-due[only tasks with no @due(...) at all]' \
            '--sort=[order the answer]:key:(due priority state index)' \
            '--today=[what today means, for --overdue and +Nd]:date:' \
            '--json[machine-readable output]' \
            '--depth=[levels to descend]:depth:' \
            '1:path:_files'
          ;;
        check)
          _arguments \
            '--item=[task index in document order]:index:' \
            '(--off --toggle --state)--on[check the box]' \
            '(--on --toggle --state)--off[uncheck the box]' \
            '(--on --off --state)--toggle[flip it (the default)]' \
            '(--on --off --toggle)--state=[set it to a named state]:state:_mark_states' \
            '--stamp[append @done(YYYY-MM-DD) when the task becomes done]' \
            '--today=[the date --stamp writes]:date:' \
            '--json[machine-readable output]' \
            '1:file:_files -g "*.md"'
          ;;
        normalize)
          # Writes to stdout unless --in-place, so the two are opposites and
          # --check is neither.
          _arguments \
            '--gfm[degrade to GFM (the default, and the only direction)]' \
            '(--check)--in-place[rewrite the file itself, atomically and under the lock]' \
            '(--in-place)--check[report what would change and write nothing]' \
            '1:file:_files -g "*.md"'
          ;;
        ls)
          _arguments \
            '--json[machine-readable output]' \
            '--depth=[levels to descend]:depth:' \
            '--all[include non-markdown files]' \
            '--git[add changed lines against git HEAD]' \
            '1:dir:_files -/'
          ;;
        watch)
          _arguments \
            '--follow[keep going instead of exiting at the first change]' \
            '--interval=[seconds between polls]:seconds:' \
            '--json[machine-readable output]' \
            '--depth=[levels to descend]:depth:' \
            '1:path:_files'
          ;;
        toc)
          _arguments \
            '--json[machine-readable output]' \
            '--insert[write the list into the document, between the markers]' \
            '--min-level=[shallowest heading level]:level:' \
            '--max-level=[deepest heading level]:level:' \
            '1:file:_files'
          ;;
        grep)
          _arguments \
            '--json[machine-readable output]' \
            {-i,--ignore-case}'[case-insensitive matching]' \
            '--depth=[levels to descend]:depth:' \
            '1:pattern:' \
            '2:path:_files'
          ;;
        links)
          _arguments \
            '--broken[only references whose local target is missing]' \
            '--images[only images, leaving links out]' \
            '--json[machine-readable output]' \
            '--depth=[levels to descend]:depth:' \
            '1:path:_files'
          ;;
        doctor|reload|sidebar)
          _arguments '--json[machine-readable output]'
          ;;
        open)
          _arguments \
            '--tab[add the tab without moving the reader]' \
            '--json[machine-readable output]' \
            '1:path:_files'
          ;;
        goto)
          _arguments '--json[machine-readable output]' '1:anchor:'
          ;;
        nav)
          _arguments \
            '(--back --forward)'{--up,--parent}'[the current root'\''s parent]' \
            '(--up --parent --forward)--back[the previous root]' \
            '(--up --parent --back)--forward[forward again, after --back]' \
            '--json[machine-readable output]' \
            '1:dir:_files -/'
          ;;
        theme)
          _arguments \
            '--system[follow the system appearance instead of pinning a half]' \
            '--list[list the available themes]' \
            '--show=[dump a theme'\''s palette and CSS]:theme:_mark_themes' \
            '--import=[convert a .tmTheme or base16 scheme]:file:_files' \
            '--json[machine-readable output]' \
            '1:theme:_mark_themes'
          ;;
        tab)
          local -a actions
          actions=(
            'list:every open tab, in bar order'
            'select:bring a tab to the front'
            'close:close a tab (with no argument, the selected one; --all closes them all)'
          )
          _arguments -C \
            '1: :{_describe -t actions "tab action" actions}' \
            '*:: :->tabargs' && return 0
          case "$state" in
            tabargs)
              case "${words[1]}" in
                list)
                  _arguments '--json[machine-readable output]'
                  ;;
                select)
                  _arguments '--json[machine-readable output]' '1:tab:_mark_tabs'
                  ;;
                close)
                  _arguments \
                    '--all[close every tab in the window]' \
                    '--json[machine-readable output]' \
                    '1:tab:_mark_tabs'
                  ;;
              esac
              ;;
          esac
          ;;
      esac
      ;;
  esac
}

_mark "$@"
